namespace shared_arguments;

query players = entity("minecraft:player") {}

item sample = item_stack("minecraft:diamond_sword") {
    components = nbt {
        "minecraft:max_stack_size" = 1;
        "minecraft:enchantment_glint_override" = true;
        "minecraft:food" = { nutrition = 2; saturation = 0.5f; can_always_eat = false; };
        "minecraft:use_cooldown" = { seconds = 1.5f; cooldown_group = "shared_arguments:sample"; };
        "minecraft:use_effects" = { can_sprint = true; speed_multiplier = 0.8f; };
        "minecraft:weapon" = { item_damage_per_attack = 2; };
        "minecraft:attack_range" = { max_reach = 4.0f; };
        "minecraft:enchantable" = { value = 12; };
        "minecraft:enchantments" = { "minecraft:sharpness" = 3; };
    };
}

@load fn demonstrate_arguments() {
    message.all(object(atlas, "minecraft:item/diamond_sword") { fallback = text("剑"); });
    message.all(object(player, "Steve", false) { fallback = "头像"; });
    message.all(text("物品") { hover = show_item("minecraft:diamond_sword", 1); });
    message.all(text("实体") { hover = show_entity("minecraft:zombie", "00000000-0000-0000-0000-000000000001", "僵尸"); });
    message.all(text("对话框") { click = show_dialog("shared_arguments:menu"); });
    message.all(text("自定义") { click = custom("shared_arguments:open", nbt { page = 1; }); });
    message.all(nbt(storage, "shared_arguments:data", "Items[{id:'minecraft:stone'}].count"));
    message.all(nbt(storage, "shared_arguments:data", "Items[{components:{'minecraft:custom_data':{group:'building',},},}].count"));
    message.all(nbt(storage, "shared_arguments:data", "Items[-1].count"));
    message.all(nbt(storage, "shared_arguments:list", "[0].id"));
    particle("minecraft:block", nbt { block_state = { id = "minecraft:oak_stairs"; properties = { facing = "north"; }; }; });
    particle("minecraft:item", nbt { item = { id = "minecraft:stone"; count = 2; components = { "minecraft:max_stack_size" = 16; }; }; });
    give(players, sample);
    clear(players, item_predicate("*") {
        equals("minecraft:max_stack_size", 1);
        matches("minecraft:count", nbt { min = 1; max = 64; });
        matches("minecraft:damage", nbt { damage = { min = 0; max = 20; }; });
        matches("minecraft:firework_explosion", nbt { shape = "star"; has_trail = true; });
        matches("minecraft:potion_contents", nbt { potions = "minecraft:water"; effects = { size = { min = 0; max = 8; }; }; });
        matches("minecraft:enchantments", [{ enchantments = "minecraft:sharpness"; levels = { min = 1; max = 5; }; }]);
    }, 0);
}
