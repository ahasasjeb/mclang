// 编译测试：计分板、数据槽与传送。
// 覆盖 objective 声明、scoreboard.get/set/reset、item_data/entity_data 数据槽的
// deposit/withdraw/remove_data、容器安全移除与 teleport 的各种落点。
//
// 验证：
//   cargo run -- build tests/valid/scoreboard -o build/tests/scoreboard --deny-raw
// 重点检查 build/tests/scoreboard/data/scoreboard_test/function/transfer.mcfunction
// 与 __mcl/load.mcfunction（目标创建）。
namespace scoreboard_test;

score next_key = 0;
objective box_key;
objective box_active;
objective jumps { criteria = "minecraft.custom:minecraft.jump"; }

// 2.6 目标属性：准则、显示名、渲染类型、数字格式与显示槽。
objective trigger_ready {
    criteria = "trigger";
    display_name = text("就绪") { color = "gold"; };
    display_slot = "sidebar";
}
objective hearts {
    render_type = "hearts";
    number_format = fixed(text("♥"));
}

query players = entity("minecraft:player") {}
query boxes = entity("minecraft:chest_minecart") { tag("box"); limit(1); }
query current = entity("minecraft:item") { tag("current"); limit(1); }

// 1.4 类型化路径：数据槽支持多段路径与下标。
data_slot stash = item_data("pc_items");
data_slot note = entity_data("pc_note.name");
data_slot nested = entity_data("pc_data.records[0].name");
storage saved = item_list("scoreboard_test:state", "saved");

fn main() {
    each(players) {
        if scoreboard.get(self, box_key) == 0 {
            next_key += 1;
            scoreboard.set(self, box_key, next_key);
            scoreboard.set(players, box_active, 1);
        }
        let key = scoreboard.get(self, box_key);
        each(boxes) {
            if scoreboard.get(self, box_key) == key && scoreboard.get(origin, box_key) == key {
                scoreboard.set(origin, box_key, 1);
                scoreboard.reset(self, box_key);
            }
        }
    }
}

// 2.6 players.enable / operation / display。
fn counters() {
    each(players) {
        scoreboard.enable(self, trigger_ready);
        scoreboard.operation(self, box_active, add, self, box_key);
        scoreboard.operation(self, box_active, max, players, hearts);
    }
    scoreboard.display("list", box_active);
    scoreboard.display("below_name");
}

@non_player
fn transfer() {
    self.deposit(stash, current);
    self.withdraw(stash, current);
    self.withdraw(note, current);
    self.remove_data(stash);
    self.set_no_gravity(true);
    self.add_tag("box");
    self.remove_preserving_items(stash, current);
}

@non_player
fn store_to_storage() {
    self.save_items(saved);
    self.restore_items(saved);
    self.remove_preserving_items(saved);
}

fn teleporting() {
    each(boxes) {
        teleport(self, pos(100, 64, -20));
        teleport(current, pos(~, ~1, ~2));
        teleport(self, current);
    }
}

@entity
fn send_home() {
    teleport(origin, pos(0, 64, 0));
}
