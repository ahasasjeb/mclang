// 编译测试：中文与其他 Unicode 标识符的内部化。
// 覆盖所有用户标识符位置（声明与引用）：计分变量、计分板目标、实体查询、
// 物品定义、物品存储、数据槽、谓词资源、进度（名称/准则/奖励/父进度）、
// 函数标签、函数名、参数与局部变量；并与 ASCII 标识符混用以检查别名避让。
//
// 验证：
//   cargo run --bin mclang -- build tests/valid/chinese_identifiers -o build/tests/chinese_identifiers --deny-raw
// 预期：编译成功；产物中只有 ASCII 标识符；不同中文名不会得到同一个别名，
// 也不会与 ascii_score / ascii_reward 的产物名相同。
namespace zh_names;

计分 次数 = 0;
计分 总分数 = 0;
计分 ascii_score = 7;
// 跨类别同名：函数与计分变量共用同一个别名，引用按语法位置区分。
计分 统计 = 0;

目标 进度目标 {
    显示名 = 文本("中文目标") { 颜色 = "gold"; };
}

目标 触发目标 {
    准则 = "trigger";
}

查询 玩家 = 实体("minecraft:player") {}
查询 单个玩家 = 实体("minecraft:player") { 上限(1); }
查询 单个僵尸 = 实体("minecraft:zombie") { 上限(1); }
查询 单个掉落物 = 实体("minecraft:item") { 上限(1); }

物品 奖励 = 物品堆("minecraft:emerald") {
    数量 = 1;
    自定义名称 = "奖励";
}
物品 ascii_reward = 物品堆("minecraft:diamond") {}

存储 存档 = 物品列表("zh_names:state", "saved");
数据槽 槽位 = 物品数据("payload");

资源 谓词 幸运 = """{"type":"minecraft:random_chance","chance":0.5}""";

函数标签 检查组 {
    值(使用调用);
}

fn 统计(增量) -> score {
    令 结果 = 增量 * 2;
    返回 结果;
}

fn 使用调用() {
    总分数 = 统计(21) + 1;
    次数 += 1;
}

fn 使用同名() {
    统计 = 1;
    总分数 = 统计(2);
    额外调用();
}

@加载
fn 初始化() {
    消息.全部("中文标识符已加载", 绿色);
}

@每刻
fn 每刻检查() {
    如果 次数 >= 20 {
        次数 = 0;
        调用 #检查组();
    }
    如果 谓词(幸运) && 计数(单个僵尸) == 1 {
        计分板.设置(玩家, 进度目标, 总分数);
    }
    如果 实体(单个僵尸) {
        计分板.启用(单个玩家, 触发目标);
    }
}

@player
fn 玩家操作() {
    消息.自身(score(自身, 进度目标) { 颜色 = "yellow"; });
    消息.自身(选择器(单个玩家));
    声音.自身("minecraft:block.note_block.pling", 主音量);
    经验.增加(单个玩家, 点数, 3);
    清除(单个玩家, "minecraft:emerald", 1);
}

@player
fn 计分板操作() {
    计分板.运算(自身, 进度目标, 加上, 自身, 触发目标);
    计分板.重置(自身, 触发目标);
}

@player
fn 读取分数() -> score {
    返回 计分板.取(自身, 进度目标) + 计分板.取(单个僵尸, 进度目标);
}

@非玩家
fn 实体数据搬运() {
    自身.添加标签("zh_checked");
    自身.设置无视重力(true);
    自身.移除数据(槽位);
    自身.保存物品(存档);
    自身.恢复物品(存档);
    自身.保存并移除(槽位, 单个掉落物);
}

@entity
fn 传送与执行() {
    传送(自身, 单个僵尸);
    执行 as(单个玩家) 在(单个玩家) 存值.结果(自身, 进度目标) {
        总分数 = 1;
    }
}

fn 物品操作() {
    给予(玩家, 奖励, 1);
    给予(玩家, ascii_reward);
    item.replace(entity, 单个玩家, "weapon.mainhand", with(奖励));
}

fn 调度检查() {
    调度 使用调用() 延后 1 秒;
    schedule.clear(使用调用);
}

fn 进度操作() {
    进度.授予(玩家, 子进度);
    进度.撤销(玩家, 根进度);
    进度.授予从(玩家, "minecraft:story/root");
}

进度 根进度 {
    准则 放置泥土 {
        触发器 = placed_block;
        条件 = """{"location":{"type":"minecraft:match_block","blocks":"minecraft:dirt"}}""";
    }
    奖励 { 函数 = 使用调用; }
}

进度 子进度 {
    父进度 = 根进度;
    准则 计时 { 触发器 = tick; }
    奖励 { 函数 = 使用调用; }
}
