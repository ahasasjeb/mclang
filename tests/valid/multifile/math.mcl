// 编译测试：多文件项目（英文关键词），被 main.mcl 的中文写法调用。
// 只使用参数的函数不需要 import；公开函数必须写 export。
namespace multifile;

export fn double(value) -> score {
    let result = value * 2;
    return result;
}

export fn triple(value) -> score {
    return value * 3;
}

export fn plus_one(value) -> score {
    let result = value + 1;
    return result;
}
