// 编译测试：多文件项目（中文关键词）。
// math.mcl 与 rewards.mcl 是子模块，通过 import/export 互相引用。
//
// 验证：
//   cargo run -- build tests/valid/multifile -o build/tests/multifile --deny-raw
namespace multifile;

import math;
import rewards;

export 计分 total = 0;
export 查询 players = 实体("minecraft:player") {}

@加载
函数 load() {
    消息.全部("多文件项目已加载", 绿色);
}

@每刻
函数 tick() {
    如果 total >= 10 {
        total = 0;
        调用 award();
    }
    total = plus_one(total);
}

函数 use_math() {
    total = double(total) + triple(1);
}
