namespace optimizations;

score x = 0;
score counter = 0;
score calls = 0;
score left = 0;
score right = 0;
objective box_a;
objective box_b;

fn and_fusion_scores() {
    if left > 3 && left < right { counter += 1; }
}

fn and_fusion_literals() {
    if left > 3 && left != 7 { counter += 1; }
}

fn and_fusion_computed() {
    if left > 3 && left + 1 < right { counter += 1; }
}

fn and_fusion_reversed() {
    if left > 3 && 7 > left + 1 { counter += 1; }
}

fn nested(a, b, c) {
    if a > 0 {
        if b > 0 {
            if c > 0 { counter += 1; }
        }
    }
}

fn constants() {
    if 1 == 1 { counter += 1; }
    if 1 + 2 == 3 { counter += 2; }
    if 1 > 10 { counter += 3; }
}

fn nested_ranges(value) {
    if value > 10 {
        if value > 5 {
            if value != 13 { counter += 1; }
        }
    }
}

fn impossible_range(value) {
    if value > 10 {
        if value < 5 { counter += 1; }
    }
}

fn contradictory_condition(value) {
    if value > 10 && value < 5 { counter += 1; }
}

fn equality_ranges(value) {
    if value == 5 {
        if value >= 5 {
            if value > 4 {
                if value != 6 { counter += 1; }
            }
        }
    }
}

fn impossible_equality(value) {
    if value == 5 {
        if value != 5 { counter += 1; }
    }
}

fn upper_range(value) {
    if value <= 5 {
        if value < 6 { counter += 1; }
    }
}

fn for_loop_ranges() {
    for index in 0..4 {
        if index >= 0 {
            if index > -1 {
                if index < 4 { counter += 1; }
            }
        }
        if index > 10 {
            if index < 4 { counter += 100; }
        }
    }
}

fn nested_for_loop_ranges() {
    for outer in -2..3 {
        for inner in 1..4 {
            if outer >= -2 {
                if outer < 3 {
                    if inner >= 1 {
                        if inner < 4 { counter += 1; }
                    }
                }
            }
        }
    }
}

fn mutated_for_loop_range() {
    for index in 0..4 {
        index = 10;
        if index < 4 { counter += 1; }
    }
}

fn counted_while_ranges() {
    let index = 0;
    while index < 4 {
        if index >= 0 {
            if index > -1 {
                if index < 4 { counter += 1; }
            }
        }
        index += 1;
    }
}

fn overflowing_while_range() {
    let index = 2147483646;
    while index < 2147483647 {
        if index >= 2147483646 { counter += 1; }
        index += 2;
    }
}

fn known_empty_while() {
    let index = 4;
    while index < 4 {
        counter += 1;
    }
}

fn boolean_identities() {
    if counter > 0 && 1 == 1 { counter += 1; }
    if counter > 0 || 1 == 0 { counter += 1; }
}

fn repeated_effect() -> score {
    calls += 1;
    return 1;
}

fn effectful_guards() {
    if repeated_effect() == 1 {
        if repeated_effect() == 1 { counter += 1; }
    }
}

fn effectful_contradiction() {
    if function(repeated_effect) && x > 10 && x < 5 { counter += 1; }
}

fn effectful_proven_true(value) {
    if value > 10 {
        if function(repeated_effect) || value > 5 { counter += 1; }
    }
}

fn effectful_proven_true_right(value) {
    if value > 10 {
        if value > 5 || function(repeated_effect) { counter += 1; }
    }
}

fn reset_guard_score() -> score {
    x = 0;
    return 1;
}

fn mutating_guards_nested() {
    if x > 10 {
        if function(reset_guard_score) {
            if x > 10 { counter += 1; }
        }
    }
}

fn mutating_guards_and() {
    if x > 10 && function(reset_guard_score) && x > 10 { counter += 1; }
}

fn duplicate_guards(lower, upper) {
    if lower < upper && lower < upper { counter += 1; }
    if block(pos(0, 64, 0), block_state("minecraft:stone")) {
        if block(pos(0, 64, 0), block_state("minecraft:stone")) { counter += 1; }
    }
}

fn duplicate_effectful_guards() {
    if function(repeated_effect) {
        if function(repeated_effect) { counter += 1; }
    }
}

fn mutate_between_guards(value) {
    if value > 10 {
        value = 0;
        if value < 5 { counter += 1; }
    }
}

fn short_circuit_effect() {
    if counter < 0 && repeated_effect() == 1 { counter += 1; }
}

fn return_stops_block() {
    counter += 1;
    return;
    counter += 2;
}

fn dead_assignment() {
    x = 1;
    x = 2;
}

fn bump() {
    counter += 1;
}

// 用户计分项可能尚无记录；读取必须先固化到预置 0 的临时项。
@entity fn dispatch_cells() {
    if scoreboard.get(self, box_a) != scoreboard.get(self, box_b) { counter += 1; }
}

// 带 else 的同一条件：两个分支测试同一对已固化临时项。
@entity fn dispatch_cells_else() {
    if scoreboard.get(self, box_a) != scoreboard.get(self, box_b) { counter += 1; }
    else { counter += 2; }
}

// 分支体调用函数：用户计分项可能被改写，条件必须先把值冻结到临时项。
@entity fn dispatch_cells_else_effectful() {
    if scoreboard.get(self, box_a) != scoreboard.get(self, box_b) { bump(); }
    else { counter += 2; }
}

// 源与目标完全相同时也必须先读取再写回，不能先把源预置为 0。
@entity fn copy_cell_to_itself() {
    scoreboard.set(self, box_a, scoreboard.get(self, box_a));
}

// else if 链：每层一个互补子句，不再为每层生成辅助函数。
fn else_chain_flat(value) {
    if value == 1 { counter += 1; }
    else { if value == 2 { counter += 2; }
    else { if value == 3 { counter += 3; }
    else { counter += 4; } } }
}

// 链上分支体改写条件读取的计分项：条件值先冻结，后续层测试冻结值。
fn else_chain_frozen(value) {
    if value == 1 { value = 9; }
    else { if value == 2 { counter += 2; } else { counter += 3; } }
}

// 嵌套 then 链的叶子带 else：外层条件并进守卫，两层只产生两条命令。
fn nested_then_flat(value) {
    if value > 10 {
        if value > 20 { counter += 1; } else { counter += 2; }
    }
}

// 函数条件链：只有分支体需要辅助函数，条件本身不再级联出文件。
fn else_chain_effectful(value) {
    if value == 1 { counter += 1; }
    else { if function(repeated_effect) { counter += 2; } else { counter += 3; } }
}

// 分支体里的表达式调用可能改写外层条件输入，外层值必须先冻结。
fn branch_expression_mutates_guard() {
    if x == 1 { let ignored = reset_guard_score(); }
    else { counter += 2; }
}

// 后续 else 条件的求值也可能改写前层条件输入，不能重复读取前层原值。
fn else_condition_mutates_guard() {
    if x == 1 { counter += 1; }
    else { if reset_guard_score() == 1 { counter += 2; } else { counter += 3; } }
}

// store.success 必须观察赋值语句本身；缺失的读取按 0 处理后，最终复制仍成功。
@entity fn copy_cell_store_success() {
    execute store.success(self, box_a) {
        scoreboard.set(self, box_b, scoreboard.get(self, box_a));
    }
}

// 超过守卫子句上限的深链：剩余部分回退成带守卫的辅助函数。
fn guard_cap(value) {
    if value == 1 { counter += 1; }
    else { if value == 2 { counter += 2; }
    else { if value == 3 { counter += 3; }
    else { if value == 4 { counter += 4; }
    else { if value == 5 { counter += 5; }
    else { if value == 6 { counter += 6; }
    else { if value == 7 { counter += 7; }
    else { if value == 8 { counter += 8; }
    else { if value == 9 { counter += 9; }
    else { counter += 10; } } } } } } } } }
}
