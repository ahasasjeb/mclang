// 编译测试：双语产物一致性（英文关键词版）。
// 与 tests/dual/zh/main.mcl 语义完全相同，两个项目分别构建后产物必须逐字节一致：
//   cargo run -- build tests/dual/en -o build/tests/dual-en --deny-raw
//   cargo run -- build tests/dual/zh -o build/tests/dual-zh --deny-raw
//   Get-ChildItem -Recurse -File build/tests/dual-en | ForEach-Object { ... 对比哈希 }
namespace dual;

import helpers;

score active = 0;
score total = 0;
score flag = 0;

objective progress;

query players = entity("minecraft:player") { limit(1); }

item reward = item_stack("minecraft:diamond") {
    count = 3;
    custom_name = "Reward";
    lore("First line");
    enchantment("minecraft:fortune", 2);
}

resource predicate lucky = """{"type":"minecraft:random_chance","chance":0.5}""";

@load
fn load() {
    message.all("loaded", green);
    place.feature(nbt { type = "minecraft:no_op"; });
}

@tick
fn tick() {
    if active == 0 && total < 10 {
        total += 1;
    } else {
        active = 1;
    }
    while total > 0 {
        total -= 1;
    }
    each(players) {
        self.give_item(reward, 2);
        sound.self("minecraft:block.note_block.pling", master);
        execute store.result(origin, progress) {
            clear(players);
        }
    }
    execute store.result(bossbar, "dual:timer", value) {
        active = active + 1;
    }
    execute as(players) at(players) if block(pos(~, ~-1, ~), block_state("minecraft:stone")) {
        self.add_tag("checked");
    }
    execute as(players) store.result(自身, progress) {
        clear(players);
    }
    execute store.data(block, pos(0, 64, 0), "Items", byte) {
        set_block(pos(0, 64, 0), block_state("minecraft:chest"));
    }
    if predicate(lucky) {
        flag = double(total) + 1;
    }
}

fn double(value) -> score {
    let result = value * 2;
    return result;
}

fn loop_showcase() {
    for index in 0..4 {
        if index == 1 {
            continue;
        }
        if index == 3 {
            break;
        }
        total += index;
    }
    while total > 5 {
        total -= 1;
        if total == 7 {
            continue;
        }
        if total == 6 {
            break;
        }
    }
    total = boost(total);
}

fn later() {
    schedule later() after 1.5 s append;
}

fn cleanup() {}

fn queue() {
    schedule cleanup() after 30 t replace;
    schedule.clear(cleanup);
}

fn_tag batch {
    value(cleanup);
    value(#announcement);
    replace = true;
}

fn_tag announcement {
    value(later);
}

fn use_tags() {
    call #batch();
}

@player
fn rich() {
    message.self(text("你好") { color = "red"; bold = true; click = run_command("/say hi"); hover = text("提示"); });
    message.all(translate("chat.type.text", [text("甲"), text("乙")]) { color = "gold"; });
    message.all(keybind("key.jump"));
    message.all(selector("@a"));
    message.nearest(16, text("附近") { italic = true; }, aqua);
    message.player(players, score(self, "runtime_objective"));
}
