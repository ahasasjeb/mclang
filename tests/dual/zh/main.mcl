// 编译测试：双语产物一致性（中文关键词版）。
// 与 tests/dual/en/main.mcl 语义完全相同，两个项目分别构建后产物必须逐字节一致。
命名空间 dual;

计分 active = 0;
计分 total = 0;
计分 flag = 0;

目标 progress;

查询 players = 实体("minecraft:player") { 上限(1); }

物品 reward = 物品堆("minecraft:diamond") {
    数量 = 3;
    自定义名称 = "Reward";
    描述("First line");
    附魔("minecraft:fortune", 2);
}

资源 谓词 lucky = """{"type":"minecraft:random_chance","chance":0.5}""";

@加载
函数 load() {
    消息.全部("loaded", 绿色);
}

@每刻
函数 tick() {
    如果 active == 0 && total < 10 {
        total += 1;
    } 否则 {
        active = 1;
    }
    当 total > 0 {
        total -= 1;
    }
    遍历(players) {
        自身.给予物品(reward, 2);
        声音.自身("minecraft:block.note_block.pling", 主音量);
        执行 存值.结果(投掷者, progress) {
            清除(players);
        }
    }
    执行 存值.结果(Boss栏, "dual:timer", 值) {
        active = active + 1;
    }
    执行 作为(players) 在(players) 如果 方块(坐标(~, ~-1, ~), 方块状态("minecraft:stone")) {
        自身.添加标签("checked");
    }
    执行 作为(players) 存值.结果(自身, progress) {
        清除(players);
    }
    执行 存值.数据(方块, 坐标(0, 64, 0), "Items", 字节) {
        设置方块(坐标(0, 64, 0), 方块状态("minecraft:chest"));
    }
    如果 谓词(lucky) {
        flag = double(total) + 1;
    }
}

函数 double(value) -> 计分 {
    令 result = value * 2;
    返回 result;
}

函数 later() {
    调度 later() 延后 1.5 秒 追加;
}

函数 cleanup() {}

函数 queue() {
    调度 cleanup() 延后 30 刻 替换;
    调度.清除(cleanup);
}

函数标签 batch {
    值(cleanup);
    值(#announcement);
    替换 = 真;
}

函数标签 announcement {
    值(later);
}

函数 use_tags() {
    调用 #batch();
}

@玩家
函数 rich() {
    消息.自身(文本("你好") { 颜色 = "红色"; 粗体 = 真; 点击 = 运行命令("/say hi"); 悬停 = 文本("提示"); });
    消息.全部(翻译("chat.type.text", [文本("甲"), 文本("乙")]) { 颜色 = "金色"; });
    消息.全部(按键("key.jump"));
    消息.全部(选择器("@a"));
    消息.最近(16, 文本("附近") { 斜体 = 真; }, 青色);
    消息.玩家(players, 计分(自身, "runtime_objective"));
}
