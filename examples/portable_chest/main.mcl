命名空间 portable_chest;

// 下一个待分配的箱子编号。编号只增不减，保证每位玩家拿到唯一编号。
计分 next_key = 0;

// 每位玩家的箱子编号；0 表示尚未分配。
目标 box_key;

// 每位玩家是否已经放出箱子：0 表示收在仓库，1 表示已放出。
目标 box_active;

@加载
函数 load() {
    // 仓库：世界边界角落里的屏障盒（5×5×5 外壳，里面 3×3×3 空气）。
    // 屏障无法破坏，玩家正常游戏到不了这里；forceload 让这个区块常驻加载，
    // 否则选择器找不到收在里面的矿车。
    强制加载.添加(列坐标(29999970, 29999970));
    填充(坐标(29999968, -62, 29999968), 坐标(29999972, -58, 29999972), 方块状态("minecraft:barrier"));
    填充(坐标(29999969, -61, 29999969), 坐标(29999971, -59, 29999971), 方块状态("minecraft:air"));
    消息.全部("便携箱子已加载：丢出单个命名为 A 的绿宝石即可切换。", 绿色);
}

// 矿车初始化只操作实体 NBT，因此声明为非玩家实体上下文。
@非玩家
函数 prepare_box() {
    自身.添加标签("pc_box");
    自身.设置无敌(true);
    自身.设置无视重力(true);
}

@每刻
函数 tick() {
    遍历(trigger_items) {
        // 先标记触发物，避免同一个掉落物每刻重复切换；
        // pc_current 让别的实体块里也能找到这枚绿宝石。
        自身.添加标签("pc_processed");
        自身.添加标签("pc_current");

        // 首次触发时分配专属编号。发射器丢出的绿宝石没有投掷者，
        // 读取失败会得到 0，下面的分支直接跳过。
        如果 计分板.取(投掷者, box_key) == 0 {
            next_key += 1;
            计分板.设置(投掷者, box_key, next_key);
        }
        令 key = 计分板.取(投掷者, box_key);

        如果 key == 0 {
            // 没有投掷者：不建立也不收取任何箱子。
        } 否则 {
            如果 计分板.取(投掷者, box_active) == 1 {
                // 收起：只处理编号与投掷者一致的已放出矿车，把它们送回主世界仓库。
                // 矿车可能在任意维度，所以要逐个维度查找；传送坐标固定在主世界。
                // 物品从来没有离开过矿车，因此不存在保存/恢复失败的可能。
                令 stowed = 0;
                在维度("minecraft:overworld") {
                    遍历(deployed_boxes) {
                        如果 计分板.取(自身, box_key) == key {
                            传送(自身, 坐标(29999970, -60, 29999970));
                            自身.添加标签("pc_stowed");
                            stowed = 1;
                        }
                    }
                }
                在维度("minecraft:the_nether") {
                    遍历(deployed_boxes) {
                        如果 计分板.取(自身, box_key) == key {
                            在维度("minecraft:overworld") {
                                传送(自身, 坐标(29999970, -60, 29999970));
                                自身.添加标签("pc_stowed");
                            }
                            stowed = 1;
                        }
                    }
                }
                在维度("minecraft:the_end") {
                    遍历(deployed_boxes) {
                        如果 计分板.取(自身, box_key) == key {
                            在维度("minecraft:overworld") {
                                传送(自身, 坐标(29999970, -60, 29999970));
                                自身.添加标签("pc_stowed");
                            }
                            stowed = 1;
                        }
                    }
                }
                如果 stowed == 1 {
                    计分板.设置(投掷者, box_active, 0);
                    消息.最近(16, "便携箱子已收起。", 金色);
                } 否则 {
                    消息.最近(16, "没有找到你的箱子，它可能在未加载的区块里。", 红色);
                }
            } 否则 {
                // 放出：优先把仓库里属于自己的矿车取回身边；第一次使用才新召唤一辆。
                令 found = 0;
                遍历(stowed_boxes) {
                    如果 计分板.取(自身, box_key) == key {
                        传送(自身, current_trigger);
                        自身.移除标签("pc_stowed");
                        found = 1;
                    }
                }
                如果 found == 0 {
                    召唤("minecraft:chest_minecart") {
                        数据 {
                            CustomName = "便携箱子";
                            Silent = true;
                        }
                        prepare_box();
                        计分板.设置(自身, box_key, key);
                    }
                }
                计分板.设置(投掷者, box_active, 1);
                消息.最近(16, "便携箱子已放出。", 绿色);
            }
        }

        自身.移除标签("pc_current");

        // 无论放出还是收起，都把触发用的绿宝石原样交还投掷者。
        给予(投掷者, 自身.物品);
    }
}
