namespace multi_counter;

import math;
import resources;
import tasks;

export score ticks = 0;
export score enabled = 1;
export score pending = 3;

@load
fn load() {
    message.all("Multi-file counter loaded", green);
}

@tick
fn tick() {
    if enabled == 1 && ticks < 100 {
        ticks += 1;
    } else {
        announce(100);
        ticks = 0;
    }
}
