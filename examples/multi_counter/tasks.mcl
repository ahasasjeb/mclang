namespace multi_counter;

import main;
import math;

// main.mcl 的 @tick 会调用 announce，因此必须 export。
export fn announce(boundary) {
    let overshoot = difference(ticks, boundary);
    if overshoot >= 0 {
        message.all("Counter reached its boundary", gold);
    }
}

// 模块私有：跨文件的循环与调度只在 tasks 内部使用。
fn drain_pending() {
    while pending > 0 {
        message.all("processing one pending task");
        pending -= 1;
    }
}

// 调度调用发生在未来的游戏刻，不构成同步递归。
fn heartbeat() {
    schedule heartbeat() after 20 t replace;
}
