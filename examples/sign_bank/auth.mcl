namespace sign_bank;
import main;
import ui;
import accounts;
import rooms;

@player fn page_ready(expected) -> score {
    let ready = 0;
    if terminal_ready() == 1 && scoreboard.get(self, auth_mode) == expected { ready = 1; }
    return ready;
}

@player fn deny() {
    title.actionbar(self, "页面已失效，或安全范围内出现其他玩家");
    sound.self("minecraft:block.note_block.bass", master);
}

export @player fn button_login() {
    if terminal_ready() == 1 {
        cancel_auth();
        scoreboard.set(self, auth_mode, 1);
        set_input_sign();
        maintain_public_signs();
    } else { deny(); }
}

export @player fn button_register() {
    if terminal_ready() == 1 {
        cancel_auth();
        scoreboard.set(self, auth_mode, 3);
        set_input_sign();
        maintain_public_signs();
    } else { deny(); }
}

export @player fn button_home() {
    if terminal_ready() == 1 {
        cancel_auth();
        reset_scratch();
        show_home_menu();
    } else { deny(); }
}

export @player fn login_account() {
    if page_ready(1) == 1 {
        if capture_input() == 1 {
            let slot = lookup_account(1);
            if slot == 0 { title.actionbar(self, "账号不存在或注册尚未完成"); }
            if slot < 0 { title.actionbar(self, "账号记录重复，已拒绝登录"); }
            if slot > 0 {
                if record_ready(slot) == 1 && account_online(slot) == 0 {
                    scoreboard.set(self, pending_slot, slot);
                    scoreboard.set(self, auth_mode, 2);
                    set_input_sign();
                    title.actionbar(self, "账号已确认：请输入密码");
                } else { title.actionbar(self, "账号在线或记录异常，拒绝登录"); }
            }
        } else { title.actionbar(self, "请输入非空账号"); }
        maintain_public_signs();
    } else { deny(); }
}

export @player fn register_account() {
    if page_ready(3) == 1 {
        if capture_input() == 1 {
            if lookup_account(0) != 0 { title.actionbar(self, "账号已存在或已被预留"); }
            else {
                let slot = first_free_slot();
                scoreboard.set(self, transfer, 0);
                execute store.result(self, transfer) { clear(self, "minecraft:emerald", 0); }
                if slot == 0 { title.actionbar(self, "32 个账号槽位已满"); }
                if scoreboard.get(self, transfer) == 0 { title.actionbar(self, "注册需要 1 枚绿宝石"); }
                if slot > 0 && scoreboard.get(self, transfer) > 0 {
                    if reserve_slot(slot) == 1 {
                        scoreboard.set(self, pending_slot, slot);
                        scoreboard.set(self, auth_mode, 4);
                        set_input_sign();
                        title.actionbar(self, "账号已存储并回读验证：请设置密码");
                    } else { title.actionbar(self, "账号写入验证失败，未扣费"); }
                }
            }
        } else { title.actionbar(self, "请输入非空账号"); }
        maintain_public_signs();
    } else { deny(); }
}

export @player fn login_password() {
    if page_ready(2) == 1 {
        let slot = scoreboard.get(self, pending_slot);
        let valid = capture_input();
        if valid == 1 && record_ready(slot) == 1 && password_matches(slot) == 1 && account_online(slot) == 0 && room_available(slot) == 1 {
            enter_account(slot);
        } else {
            scoreboard.set(self, pending_slot, 0);
            scoreboard.set(self, auth_mode, 1);
            title.actionbar(self, "密码错误、仓库有人或账号记录异常，请重新登录");
        }
        reset_scratch();
        set_input_sign();
        maintain_public_signs();
    } else { deny(); }
}

export @player fn register_password() {
    if page_ready(4) == 1 {
        let slot = scoreboard.get(self, pending_slot);
        if capture_input() == 1 {
            scoreboard.set(self, transfer, 0);
            execute store.result(self, transfer) { clear(self, "minecraft:emerald", 0); }
            if scoreboard.get(self, transfer) > 0 && room_available(slot) == 1 && record_ready(slot) == 0 && write_password(slot) == 1 {
                scoreboard.set(self, transfer, 0);
                execute store.result(self, transfer) { clear(self, "minecraft:emerald", 1); }
                if scoreboard.get(self, transfer) == 1 {
                    complete_record(slot);
                    open_new_room(slot);
                    enter_account(slot);
                    title.actionbar(self, "注册成功，已扣除 1 枚绿宝石");
                } else {
                    release_slot(slot);
                    cancel_auth();
                    title.actionbar(self, "扣费失败，注册已取消");
                }
            } else {
                cancel_auth();
                title.actionbar(self, "注册失败：缺少绿宝石、仓库有人或记录未通过回读");
            }
            reset_scratch();
            set_input_sign();
        } else { title.actionbar(self, "密码不能为空"); }
        maintain_public_signs();
    } else { deny(); }
}
