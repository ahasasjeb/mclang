// 告示牌银行 v2：首屏菜单 -> 独立账号页 -> 独立密码页。
// 账户是否占用直接由机房记录牌表示；余额与尺寸保存在账户 marker 上。
namespace sign_bank;

import rooms;

score installed = 0;
score maintenance_ticks = 0;

export objective session;
export objective transfer;
export objective view_balance;
export objective view_size;
export objective leave_count { criteria = "minecraft.custom:minecraft.leave_game"; }
export objective leave_seen;
export objective in_room;
export objective in_terminal;
// 0=首屏, 1=登录账号, 2=登录密码, 3=注册账号, 4=注册密码。
export objective auth_mode;
export objective pending_slot;

export query all_players = entity("minecraft:player") {}
query terminal_players = entity("minecraft:player") { box(-8, 64, 1, 16, 6, 10); }
query terminal_player = entity("minecraft:player") { box(-8, 64, 1, 16, 6, 10); limit(1); }
query pending_registrations = entity("minecraft:player") { scores("auth_mode", "4"); }

@load fn load() {
    forceload.add(column(-16, -16), column(559, 15));
    if installed == 0 {
        install_world();
        installed = 1;
    }
    maintain_public_signs();
    maintain_room_signs();
    message.all("告示牌银行 v2 已加载：请从大厅首屏选择登录或注册。", green);
}

@tick fn tick() {
    maintenance_ticks += 1;
    if maintenance_ticks >= 20 {
        maintenance_ticks = 0;
        maintain_public_signs();
        maintain_room_signs();
    }

    each(all_players) {
        scoreboard.set(self, in_room, 0);
        scoreboard.set(self, in_terminal, 0);
        let leaves = scoreboard.get(self, leave_count);
        if leaves != scoreboard.get(self, leave_seen) {
            scoreboard.set(self, leave_seen, leaves);
            if scoreboard.get(self, auth_mode) != 0 { cancel_auth(); }
            if scoreboard.get(self, session) != 0 { force_logout(); }
        }
    }

    tick_rooms();
    each(all_players) {
        if scoreboard.get(self, session) != 0 && scoreboard.get(self, in_room) == 0 {
            title.actionbar(self, "已离开安全仓库，会话注销");
            force_logout();
        }
    }

    let users = count(terminal_players);
    each(terminal_players) {
        scoreboard.set(self, in_terminal, 1);
    }
    each(all_players) {
        if scoreboard.get(self, auth_mode) != 0 && scoreboard.get(self, in_terminal) == 0 {
            title.actionbar(self, "离开登录区，认证取消");
            cancel_auth();
        }
    }
    cleanup_orphan_reservations();

    if users > 1 {
        each(terminal_players) {
            if scoreboard.get(self, auth_mode) != 0 {
                title.actionbar(self, "登录区出现第二名玩家，认证取消");
                cancel_auth();
            }
        }
        show_home_menu();
    }
}

fn install_world() {
    fill(pos(-10, 63, -12), pos(10, 63, 12), block_state("minecraft:smooth_stone"));
    fill(pos(-8, 64, 0), pos(8, 70, 0), block_state("minecraft:polished_deepslate"));
    fill(pos(-8, 64, 11), pos(8, 66, 11), block_state("minecraft:polished_deepslate"));
    fill(pos(-8, 64, 1), pos(-8, 66, 10), block_state("minecraft:polished_deepslate"));
    fill(pos(8, 64, 1), pos(8, 66, 10), block_state("minecraft:polished_deepslate"));

    fill(pos(-10, 63, -10), pos(10, 82, -2), block_state("minecraft:barrier"));
    fill(pos(-9, 64, -9), pos(9, 81, -3), block_state("minecraft:air"));
    fill(pos(-9, 64, -8), pos(9, 81, -8), block_state("minecraft:barrier"));

    show_home_menu();
    build_room_shells();
}

fn terminal_ready() -> score {
    let ready = 0;
    if count(terminal_players) == 1 { ready = 1; }
    return ready;
}

@player fn deny_terminal() {
    title.actionbar(self, "登录区必须只有你一名玩家");
    sound.self("minecraft:block.note_block.bass", master);
    cancel_auth();
}

fn maintain_public_signs() {
    // 清除早期测试版的高位和远端告示牌。
    set_block(pos(-3, 66, 1), block_state("minecraft:air"));
    set_block(pos(3, 66, 1), block_state("minecraft:air"));
    set_block(pos(0, 68, 1), block_state("minecraft:air"));

    let users = count(terminal_players);
    if users != 1 {
        show_home_menu();
    }
    if users == 1 {
        let page = scoreboard.get(terminal_player, auth_mode);
        if page == 0 { show_home_menu(); }
        if page == 1 { show_login_account(); }
        if page == 2 { show_login_password(); }
        if page == 3 { show_register_account(); }
        if page == 4 { show_register_password(); }
        if page < 0 || page > 4 { show_home_menu(); }
    }
}

fn show_home_menu() {
    set_block(pos(0, 67, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["告示牌账户银行", "账户系统首屏", "32个账户槽位", "下方选择登录或注册"]; color = "gold"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = true;
    });
    set_block(pos(0, 66, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["欢迎使用", "注册费 1 绿宝石", "仓库 3×3 至 10×10", "选择后开放输入牌"]; color = "aqua"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = true;
    });
    set_block(pos(-1, 65, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【登录账户】"; color = "aqua"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:button_login"; }; }, "进入账号登录", "━━━━━━"]; color = "dark_aqua"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        allow_op_features = true; is_waxed = true;
    });
    set_block(pos(1, 65, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【注册账户】"; color = "green"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:button_register"; }; }, "创建新账户", "━━━━━━"]; color = "dark_green"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        allow_op_features = true; is_waxed = true;
    });
}

