fn ensure_input_sign() {
    if !block(pos(0, 66, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }) {
        set_input_sign();
    }
}

fn set_input_sign() {
    set_block(pos(0, 66, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = false;
    });
}

fn set_back_sign() {
    set_block(pos(1, 65, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = {
            messages = ["━━━━━━", { text = "【返回首屏】"; color = "red"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:button_home"; }; }, "取消本次操作", "━━━━━━"];
            color = "dark_red"; has_glowing_text = true;
        };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        allow_op_features = true;
        is_waxed = true;
    });
}

fn reset_stages() {
    set_block(pos(5, 66, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = true;
    });
    clone(pos(5, 66, -7), pos(5, 66, -7), pos(6, 66, -7), force);
    clone(pos(5, 66, -7), pos(5, 66, -7), pos(7, 66, -7), force);
    clone(pos(5, 66, -7), pos(5, 66, -7), pos(8, 66, -7), force);
}

fn copy_account_input() {
    data.modify(block, pos(6, 66, -7), "front_text.messages[0]", set, from(block, pos(0, 66, 1), "front_text.messages[0]"));
}

fn prepare_credential(slot) {
    reset_stages();
    // 编译期循环：源坐标由索引算出，只保留一条运行期守卫。
    unroll for index in 1..33 {
        if index == slot {
            data.modify(block, pos(5, 66, -7), "front_text.messages[0]", set, from(block, pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7), "front_text.messages[0]"));
        }
    }
    data.modify(block, pos(5, 66, -7), "front_text.messages[1]", set, from(block, pos(0, 66, 1), "front_text.messages[0]"));
    data.modify(block, pos(7, 66, -7), "front_text.messages[0]", set, from(block, pos(0, 66, 1), "front_text.messages[0]"));
}

export @player fn button_login() {
    if terminal_ready() == 1 {
        scoreboard.set(self, auth_mode, 1);
        scoreboard.set(self, pending_slot, 0);
        set_input_sign();
        maintain_public_signs();
        title.actionbar(self, "登录第1步：请输入账号");
        sound.self("minecraft:block.note_block.hat", master);
    } else { deny_terminal(); }
}

export @player fn button_register() {
    if terminal_ready() == 1 {
        scoreboard.set(self, auth_mode, 3);
        scoreboard.set(self, pending_slot, 0);
        set_input_sign();
        maintain_public_signs();
        title.actionbar(self, "注册第1步：请输入新账号");
        sound.self("minecraft:block.note_block.hat", master);
    } else { deny_terminal(); }
}

export @player fn button_home() {
    cancel_auth();
    show_home_menu();
    title.actionbar(self, "已返回首屏");
    sound.self("minecraft:block.note_block.hat", master);
}

export @player fn login_account() {
    if terminal_ready() == 1 {
        title.actionbar(self, "正在检查登录账号……");
        sound.self("minecraft:block.note_block.hat", master);
        process_login_account();
    } else { deny_terminal(); }
}

@player fn process_login_account() {
    reset_stages();
    copy_account_input();
    let slot = 0;
    if blocks(pos(6, 66, -7), pos(6, 66, -7), pos(8, 66, -7)) {
        title.actionbar(self, "账号不能为空");
        sound.self("minecraft:block.note_block.bass", master);
    } else {
        slot = find_account();
        if slot == 0 {
            title.actionbar(self, "账号不存在");
            sound.self("minecraft:block.note_block.bass", master);
        } else {
            if account_online(slot) == 1 {
                title.actionbar(self, "这个账户已经在线");
                sound.self("minecraft:block.note_block.bass", master);
            } else {
                scoreboard.set(self, pending_slot, slot);
                scoreboard.set(self, auth_mode, 2);
                title.actionbar(self, "账号存在：请输入密码");
                sound.self("minecraft:block.note_block.pling", master);
            }
        }
    }
    set_input_sign();
    maintain_public_signs();
}

export @player fn register_account() {
    if terminal_ready() == 1 {
        title.actionbar(self, "正在检查注册账号……");
        sound.self("minecraft:block.note_block.hat", master);
        process_register_account();
    } else { deny_terminal(); }
}

@player fn process_register_account() {
    reset_stages();
    copy_account_input();
    let valid = 1;
    if blocks(pos(6, 66, -7), pos(6, 66, -7), pos(8, 66, -7)) {
        valid = 0;
        title.actionbar(self, "账号不能为空");
    }
    if account_exists() == 1 {
        valid = 0;
        title.actionbar(self, "这个账号已经存在");
    }
    let slot = first_free_slot();
    if slot == 0 {
        valid = 0;
        title.actionbar(self, "32 个账户槽位已经用完");
    }
    scoreboard.set(self, transfer, 0);
    execute store.result(self, transfer) { clear(self, "minecraft:emerald", 0); }
    if scoreboard.get(self, transfer) < 1 {
        valid = 0;
        title.actionbar(self, "注册需要 1 枚绿宝石");
    }
    if valid == 1 {
        reserve_account(slot);
        scoreboard.set(self, pending_slot, slot);
        scoreboard.set(self, auth_mode, 4);
        title.actionbar(self, "账号可用：请设置密码");
        sound.self("minecraft:block.note_block.pling", master);
    } else {
        sound.self("minecraft:block.note_block.bass", master);
    }
    set_input_sign();
    maintain_public_signs();
}

export @player fn login_password() {
    if terminal_ready() == 1 {
        title.actionbar(self, "正在核对登录密码……");
        sound.self("minecraft:block.note_block.hat", master);
        process_login_password();
    } else { deny_terminal(); }
}

@player fn process_login_password() {
    let slot = scoreboard.get(self, pending_slot);
    prepare_credential(slot);
    if blocks(pos(7, 66, -7), pos(7, 66, -7), pos(8, 66, -7)) {
        title.actionbar(self, "密码不能为空");
        sound.self("minecraft:block.note_block.bass", master);
    } else {
        if credential_matches(slot) == 1 && account_online(slot) == 0 {
            create_account_marker(slot);
            scoreboard.set(self, auth_mode, 0);
            scoreboard.set(self, pending_slot, 0);
            title.actionbar(self, "登录成功");
            enter_account(slot);
        } else {
            scoreboard.set(self, auth_mode, 1);
            scoreboard.set(self, pending_slot, 0);
            title.actionbar(self, "密码错误：请重新输入账号");
            sound.self("minecraft:block.note_block.bass", master);
        }
    }
    set_input_sign();
    maintain_public_signs();
}

export @player fn register_password() {
    if terminal_ready() == 1 {
        title.actionbar(self, "正在创建账户……");
        sound.self("minecraft:block.note_block.hat", master);
        process_register_password();
    } else { deny_terminal(); }
}

@player fn process_register_password() {
    let slot = scoreboard.get(self, pending_slot);
    prepare_credential(slot);
    if blocks(pos(7, 66, -7), pos(7, 66, -7), pos(8, 66, -7)) {
        title.actionbar(self, "密码不能为空");
        sound.self("minecraft:block.note_block.bass", master);
    } else {
        scoreboard.set(self, transfer, 0);
        execute store.result(self, transfer) { clear(self, "minecraft:emerald", 0); }
        if scoreboard.get(self, transfer) < 1 {
            title.actionbar(self, "缺少注册所需的绿宝石");
            sound.self("minecraft:block.note_block.bass", master);
            cancel_auth();
        } else {
            clear(self, "minecraft:emerald", 1);
            store_credential(slot);
            create_account_marker(slot);
            scoreboard.set(self, auth_mode, 0);
            scoreboard.set(self, pending_slot, 0);
            activate_new_account(slot);
            title.actionbar(self, "注册成功");
            sound.self("minecraft:block.enchantment_table.use", master);
        }
    }
    set_input_sign();
    maintain_public_signs();
}

fn find_account() -> score {
    let found = 0;
    unroll for index in 1..33 {
        if found == 0 && block(pos(-4 + (index - 1) % 8, 66 + 2 * ((index - 1) / 8), -7), block_state("minecraft:oak_wall_sign")) && blocks(pos(6, 66, -7), pos(6, 66, -7), pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7)) {
            found = index;
        }
    }
    return found;
}

fn credential_matches(slot) -> score {
    let matched = 0;
    unroll for index in 1..33 {
        if index == slot && blocks(pos(5, 66, -7), pos(5, 66, -7), pos(-4 + (index - 1) % 8, 66 + 2 * ((index - 1) / 8), -7)) {
            matched = 1;
        }
    }
    return matched;
}

fn account_exists() -> score {
    let found = 0;
    unroll for index in 1..33 {
        if blocks(pos(6, 66, -7), pos(6, 66, -7), pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7)) {
            found = 1;
        }
    }
    return found;
}

fn first_free_slot() -> score {
    let slot = 0;
    unroll for index in 1..33 {
        if slot == 0 && !block(pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7), block_state("minecraft:oak_wall_sign")) {
            slot = index;
        }
    }
    return slot;
}

fn reserve_account(slot) {
    unroll for index in 1..33 {
        if index == slot {
            clone(pos(6, 66, -7), pos(6, 66, -7), pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7), force);
        }
    }
}

fn store_credential(slot) {
    unroll for index in 1..33 {
        if index == slot {
            clone(pos(5, 66, -7), pos(5, 66, -7), pos(-4 + (index - 1) % 8, 66 + 2 * ((index - 1) / 8), -7), force);
        }
    }
}

fn release_reservation(slot) {
    unroll for index in 1..33 {
        if index == slot && !block(pos(-4 + (index - 1) % 8, 66 + 2 * ((index - 1) / 8), -7), block_state("minecraft:oak_wall_sign")) {
            set_block(pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7), block_state("minecraft:air"));
        }
    }
}

fn cleanup_orphan_reservations() {
    if count(pending_registrations) == 0 {
        unroll for index in 1..33 {
            if block(pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7), block_state("minecraft:oak_wall_sign")) && !block(pos(-4 + (index - 1) % 8, 66 + 2 * ((index - 1) / 8), -7), block_state("minecraft:oak_wall_sign")) {
                set_block(pos(-4 + (index - 1) % 8, 74 + 2 * ((index - 1) / 8), -7), block_state("minecraft:air"));
            }
        }
    }
}

fn account_online(slot) -> score {
    let online = 0;
    each(all_players) {
        if scoreboard.get(self, session) == slot { online = 1; }
    }
    return online;
}

@player fn cancel_auth() {
    let page = scoreboard.get(self, auth_mode);
    let slot = scoreboard.get(self, pending_slot);
    if page == 4 { release_reservation(slot); }
    scoreboard.set(self, auth_mode, 0);
    scoreboard.set(self, pending_slot, 0);
    set_input_sign();
    maintain_public_signs();
}

export @player fn force_logout() {
    cancel_auth();
    scoreboard.set(self, session, 0);
    scoreboard.set(self, in_room, 0);
    teleport(self, vec3(0.5, 64.0, 5.5), rotation(180, 0));
    title.actionbar(self, "银行会话已结束");
}

