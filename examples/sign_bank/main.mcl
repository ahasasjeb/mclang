        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = true;
    });
    set_block(pos(-1, 65, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【提交登录账号】"; color = "green"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:login_account"; }; }, "检查账户是否存在", "━━━━━━"]; color = "dark_green"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
