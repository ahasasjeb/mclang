fn show_register_password() {
    ensure_input_sign();
    set_block(pos(0, 67, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["注册 / 第2步", "账号已经临时保留", "第1行设置密码", "提交后扣 1 绿宝石"]; color = "gold"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = true;
    });
    set_block(pos(-1, 65, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【提交注册密码】"; color = "green"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:register_password"; }; }, "扣费并创建账户", "━━━━━━"]; color = "dark_green"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        allow_op_features = true; is_waxed = true;
    });
