    set_block(pos(0, 67, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["注册 / 第1步", "编辑中间输入牌", "第1行只写新账号", "需要 1 枚绿宝石"]; color = "green"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        is_waxed = true;
    });
    set_block(pos(-1, 65, 1), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【提交注册账号】"; color = "green"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:register_account"; }; }, "检查账号并预留", "━━━━━━"]; color = "dark_green"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; };
        allow_op_features = true; is_waxed = true;
