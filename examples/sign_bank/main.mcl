// Credentials use separate signs. Slot IDs never depend on account text.
namespace sign_bank;
import ui;
import auth;
import accounts;
import rooms;
import displays;

score installed = 0;
score revision = 0;
score maintenance_ticks = 0;
score reset_pending = 0;
export objective session;
export objective pending_slot;
export objective auth_mode;
export objective transfer;
export objective view_balance;
export objective view_size;
export objective leave_count { criteria = "minecraft.custom:minecraft.leave_game"; }
export objective leave_seen;
export objective account_slot;
export objective account_balance;
export objective account_size;
export objective account_ready;
export objective room_valid;

export query all_players = entity("minecraft:player") {}
export query terminal_players = entity("minecraft:player") { box(-7, 64, 1, 14, 6, 9); }
export query terminal_player = entity("minecraft:player") { box(-7, 64, 1, 14, 6, 9); limit(1); }
export query account_markers = entity("minecraft:marker") { tag("sb_account"); }
query pending_registrations = entity("minecraft:player") { scores("auth_mode", "4"); }

@load fn load() {
    in_dimension("minecraft:overworld") {
        forceload.add(column(-16, -16), column(15, 15));
        forceload.add(column(96, 0), column(607, 15));
        if installed == 0 { reset_pending = 1; schedule finish_reset() after 1 t replace; }
        clear_displays();
        each(all_players) {
            cancel_auth();
            if scoreboard.get(self, session) != 0 { force_logout(); }
        }
        if revision == 3 {
            cleanup_reservations();
            maintain_public_signs();
        } else { if installed != 0 {
            message.all("银行格式已更新：备份后执行 /function sign_bank:reset 重建测试区域。", yellow);
        } }
    }
}

@tick fn tick() {
    if revision == 3 {
        in_dimension("minecraft:overworld") {
            each(all_players) {
                let leaves = scoreboard.get(self, leave_count);
                if leaves != scoreboard.get(self, leave_seen) {
                    scoreboard.set(self, leave_seen, leaves);
                    cancel_auth();
                    if scoreboard.get(self, session) != 0 { force_logout(); }
                }
                scoreboard.set(self, room_valid, 0);
                if scoreboard.get(self, session) != 0 { scoreboard.set(self, room_valid, valid_room_session()); }
                if scoreboard.get(self, auth_mode) != 0 {
                    if terminal_ready() == 0 { cancel_auth(); }
                }
            }
            // Snapshot all sessions before teleporting anybody, so both occupants are evicted.
            each(all_players) {
                if scoreboard.get(self, room_valid) == 0 && (scoreboard.get(self, session) != 0 || in_warehouse_area() == 1) { force_logout(); }
            }
            maintenance_ticks += 1;
            if maintenance_ticks >= 20 {
                maintenance_ticks = 0;
                maintain_public_signs();
                cleanup_reservations();
                cleanup_displays();
            }
        }
    }
}

// This explicit command resets test data; /reload never rebuilds rooms.
export fn reset() {
    in_dimension("minecraft:overworld") {
        each(all_players) {
            cancel_auth();
            if scoreboard.get(self, session) != 0 { force_logout(); }
        }
        revision = 0;
        reset_pending = 1;
        forceload.add(column(-16, -16), column(15, 15));
        forceload.add(column(96, 0), column(607, 15));
        schedule finish_reset() after 1 t replace;
    }
}

fn finish_reset() {
    in_dimension("minecraft:overworld") {
        let ready = 1;
        if !loaded(pos(-10, 64, -10)) || !loaded(pos(10, 64, 10)) { ready = 0; }
        unroll for index in 1..33 {
            if !loaded(pos(100 + 16 * (index - 1), 64, 0)) { ready = 0; }
        }
        if reset_pending == 1 {
            if ready == 1 {
                install();
                reset_pending = 0;
                message.all("银行 v3 已重建，测试账号和仓库已清空。", yellow);
            } else { schedule finish_reset() after 10 t replace; }
        }
    }
}

fn install() {
    forceload.add(column(-16, -16), column(15, 15));
    forceload.add(column(96, 0), column(607, 15));
    clear_displays();
    kill(account_markers);
    fill(pos(-10, 63, -12), pos(10, 63, 12), block_state("minecraft:smooth_stone"));
    fill(pos(-8, 64, 0), pos(8, 70, 0), block_state("minecraft:polished_deepslate"));
    fill(pos(-10, 63, -10), pos(10, 82, -2), block_state("minecraft:barrier"));
    fill(pos(-9, 64, -9), pos(9, 81, -3), block_state("minecraft:air"));
    fill(pos(-9, 64, -8), pos(9, 81, -8), block_state("minecraft:barrier"));
    build_rooms();
    make_button_templates();
    reset_scratch();
    installed = 1;
    revision = 3;
    show_home_menu();
}

export @player fn terminal_ready() -> score {
    let ready = 0;
    if revision == 3 && dimension("minecraft:overworld") && count(terminal_players) == 1 {
        let x = data.get(entity, self, "Pos[0]");
        let y = data.get(entity, self, "Pos[1]");
        let z = data.get(entity, self, "Pos[2]");
        if x >= -7 && x <= 7 && y >= 64 && y <= 70 && z >= 1 && z <= 10 && scoreboard.get(self, session) == 0 {
            ready = 1;
        }
    }
    return ready;
}

export fn account_online(slot) -> score {
    let online = 0;
    each(all_players) {
        if scoreboard.get(self, session) == slot { online += 1; }
    }
    return online;
}

fn cleanup_reservations() {
    if count(pending_registrations) == 0 { clear_uncommitted(); }
}

export @player fn cancel_auth() {
    let slot = scoreboard.get(self, pending_slot);
    if scoreboard.get(self, auth_mode) == 4 { release_slot(slot); }
    scoreboard.set(self, pending_slot, 0);
    scoreboard.set(self, auth_mode, 0);
}

export @player fn force_logout() {
    let slot = scoreboard.get(self, session);
    remove_display(slot);
    cancel_auth();
    scoreboard.set(self, session, 0);
    scoreboard.set(self, view_balance, 0);
    scoreboard.set(self, view_size, 0);
    in_dimension("minecraft:overworld") { teleport(self, vec3(0.5, 64, 5.5), rotation(180, 0)); }
    title.actionbar(self, "会话已注销，返回银行大厅");
}
