namespace sign_bank;
import main;
import accounts;
import displays;
import bank;

query nearby_players = entity("minecraft:player") { distance("..10.5"); }

export fn build_rooms() {
    unroll for index in 1..33 {
        fill(pos(100 + 16 * (index - 1), 63, 0), pos(111 + 16 * (index - 1), 70, 13), block_state("minecraft:bedrock"));
        spawn("minecraft:marker", pos(106 + 16 * (index - 1), 67, 7)) {
            self.add_tag("sb_account");
            scoreboard.set(self, account_slot, index);
            scoreboard.set(self, account_balance, 0);
            scoreboard.set(self, account_size, 3);
            scoreboard.set(self, account_ready, 0);
        }
    }
}

export fn make_button_templates() {
    set_block(pos(5, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; }, nbt {
        front_text = { messages = ["存入全部绿宝石", {text = "【存入】"; color = "green"; click_event = {action = "run_command"; command = "/function sign_bank:bank/deposit";};}, "", "余额显示在上方"]; color = "green"; };
        is_waxed = true; allow_op_features = true;
    });
    set_block(pos(6, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; }, nbt {
        front_text = { messages = ["取出一枚绿宝石", {text = "【取款】"; color = "aqua"; click_event = {action = "run_command"; command = "/function sign_bank:bank/withdraw";};}, "", "每次 1 枚"]; color = "cyan"; };
        is_waxed = true; allow_op_features = true;
    });
    set_block(pos(7, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; }, nbt {
        front_text = { messages = ["扩建一圈仓库", {text = "【升级】"; color = "gold"; click_event = {action = "run_command"; command = "/function sign_bank:bank/upgrade";};}, "费用 = 新边长", "上限 10×10"]; color = "yellow"; };
        is_waxed = true; allow_op_features = true;
    });
    set_block(pos(8, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; }, nbt {
        front_text = { messages = ["退出并返回大厅", {text = "【退出】"; color = "red"; click_event = {action = "run_command"; command = "/function sign_bank:bank/logout";};}, "", "房间和物品保留"]; color = "red"; };
        is_waxed = true; allow_op_features = true;
    });
}

// Every relative coordinate below is based on the slot's fixed marker.
export fn open_new_room(slot) {
    each(account_markers) {
        if scoreboard.get(self, account_slot) == slot {
            fill(pos(~-5, ~-3, ~-6), pos(~-3, ~2, ~-2), block_state("minecraft:air"));
            fill(pos(~-5, ~-4, ~-6), pos(~-3, ~-4, ~-5), block_state("minecraft:smooth_stone"));
            fill(pos(~-5, ~-4, ~-4), pos(~-3, ~-4, ~-2), block_state("minecraft:chiseled_stone_bricks"));
            fill(pos(~-5, ~2, ~-6), pos(~-3, ~2, ~-2), block_state("minecraft:light") { level = "15"; });
            install_buttons();
        }
    }
}

@non_player fn install_buttons() {
    clone(pos(5, 72, -7), pos(5, 72, -7), pos(~-5, ~-2, ~-6), force);
    clone(pos(6, 72, -7), pos(6, 72, -7), pos(~-3, ~-2, ~-6), force);
    clone(pos(7, 72, -7), pos(7, 72, -7), pos(~-5, ~-3, ~-6), force);
    clone(pos(8, 72, -7), pos(8, 72, -7), pos(~-3, ~-3, ~-6), force);
}

export fn room_available(slot) -> score {
    let available = 0;
    if unique_record(slot) == 1 {
        each(account_markers) {
            if scoreboard.get(self, account_slot) == slot && count(nearby_players) == 0 { available = 1; }
        }
    }
    return available;
}

export @player fn enter_account(slot) {
    scoreboard.set(self, auth_mode, 0);
    scoreboard.set(self, pending_slot, 0);
    scoreboard.set(self, session, slot);
    unroll for index in 1..33 {
        if index == slot {
            execute positioned(pos(102 + 16 * (index - 1), 64, 2)) {
                teleport(self, vec3(~0.5, ~0.0, ~0.5), rotation(180, 0));
            }
        }
    }
    refresh_display(slot);
}

export @player fn in_warehouse_area() -> score {
    let inside = 0;
    if dimension("minecraft:overworld") {
        let x = data.get(entity, self, "Pos[0]");
        let y = data.get(entity, self, "Pos[1]");
        let z = data.get(entity, self, "Pos[2]");
        if x >= 100 && x <= 607 && y >= 63 && y <= 70 && z >= 0 && z <= 13 { inside = 1; }
    }
    return inside;
}

export @player fn valid_room_session() -> score {
    let valid = 0;
    let slot = scoreboard.get(self, session);
    if dimension("minecraft:overworld") && record_ready(slot) == 1 && account_online(slot) == 1 {
        let occupants = 0;
        let size = 0;
        each(account_markers) {
            if scoreboard.get(self, account_slot) == slot {
                occupants = count(nearby_players);
                size = scoreboard.get(self, account_size);
            }
        }
        let x = data.get(entity, self, "Pos[0]") - 100 - 16 * (slot - 1);
        let y = data.get(entity, self, "Pos[1]");
        let z = data.get(entity, self, "Pos[2]");
        if occupants == 1 && size >= 3 && size <= 10 && y >= 64 && y <= 69 {
            if x >= 1 && x <= 3 && z >= 1 && z <= 2 { valid = 1; }
            if x >= 1 && x <= size && z >= 3 && z <= size + 2 { valid = 1; }
        }
    }
    return valid;
}

export fn expand_room(slot, size) {
    // Runtime score values cannot be block coordinates; unroll resolves these constants.
    unroll for index in 1..33 {
        if index == slot {
            unroll for width in 4..11 {
                if width == size {
                    fill(pos(100 + 16 * (index - 1) + width, 64, 3), pos(100 + 16 * (index - 1) + width, 69, width + 2), block_state("minecraft:air"), replace, block_state("minecraft:bedrock"));
                    fill(pos(101 + 16 * (index - 1), 64, width + 2), pos(99 + 16 * (index - 1) + width, 69, width + 2), block_state("minecraft:air"), replace, block_state("minecraft:bedrock"));
                    fill(pos(100 + 16 * (index - 1) + width, 63, 3), pos(100 + 16 * (index - 1) + width, 63, width + 2), block_state("minecraft:chiseled_stone_bricks"));
                    fill(pos(101 + 16 * (index - 1), 63, width + 2), pos(99 + 16 * (index - 1) + width, 63, width + 2), block_state("minecraft:chiseled_stone_bricks"));
                    fill(pos(101 + 16 * (index - 1), 69, 3), pos(100 + 16 * (index - 1) + width, 69, width + 2), block_state("minecraft:light") { level = "15"; }, replace, block_state("minecraft:air"));
                }
            }
        }
    }
}
