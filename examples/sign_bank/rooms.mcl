        clone(pos(8, 72, -7), pos(8, 72, -7), pos(481, 66, 1), force);
    }
    if block(pos(0, 72, -7), block_state("minecraft:oak_wall_sign")) {
        set_block(pos(494, 67, 1), block_state("minecraft:air"));
        clone(pos(5, 72, -7), pos(5, 72, -7), pos(493, 67, 1), force);
        clone(pos(6, 72, -7), pos(6, 72, -7), pos(495, 67, 1), force);
