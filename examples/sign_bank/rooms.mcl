item one_emerald = item_stack("minecraft:emerald") {}

export fn build_room_shells() {
    // 编译期循环：仓库左下角是 100 + 14 * (索引 - 1)，外壳固定 12×8×14。
    unroll for index in 1..33 {
        fill(pos(100 + 14 * (index - 1), 63, 0), pos(111 + 14 * (index - 1), 70, 13), block_state("minecraft:barrier"));
    }
}

export fn maintain_room_signs() {
    set_block(pos(5, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【存入全部】"; color = "green"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:rooms/deposit"; }; }, "背包绿宝石入账", "━━━━━━"]; color = "dark_green"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; }; allow_op_features = true; is_waxed = true;
    });
    set_block(pos(6, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【取出1枚】"; color = "aqua"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:rooms/withdraw"; }; }, "从余额取绿宝石", "━━━━━━"]; color = "dark_aqua"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; }; allow_op_features = true; is_waxed = true;
    });
    set_block(pos(7, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【升级仓库】"; color = "gold"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:rooms/upgrade"; }; }, "扩建下一圈空间", "━━━━━━"]; color = "yellow"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; }; allow_op_features = true; is_waxed = true;
    });
    set_block(pos(8, 72, -7), block_state("minecraft:oak_wall_sign") { facing = "south"; waterlogged = "false"; }, nbt {
        front_text = { messages = ["━━━━━━", { text = "【安全退出】"; color = "red"; bold = true; click_event = { action = "run_command"; command = "/function sign_bank:rooms/logout"; }; }, "注销并返回大厅", "━━━━━━"]; color = "dark_red"; has_glowing_text = true; };
        back_text = { messages = ["", "", "", ""]; color = "black"; has_glowing_text = false; }; allow_op_features = true; is_waxed = true;
    });
    // 编译期循环：守卫是槽位是否已注册（运行期方块检查），目标坐标由索引算出。
    unroll for index in 1..33 {
        if block(pos(-4 + (index - 1) % 8, 66 + 2 * ((index - 1) / 8), -7), block_state("minecraft:oak_wall_sign")) {
            set_block(pos(100 + 14 * (index - 1) + 2, 67, 1), block_state("minecraft:air"));
            clone(pos(5, 72, -7), pos(5, 72, -7), pos(100 + 14 * (index - 1) + 1, 67, 1), force);
            clone(pos(6, 72, -7), pos(6, 72, -7), pos(100 + 14 * (index - 1) + 3, 67, 1), force);
            clone(pos(7, 72, -7), pos(7, 72, -7), pos(100 + 14 * (index - 1) + 1, 66, 1), force);
            clone(pos(8, 72, -7), pos(8, 72, -7), pos(100 + 14 * (index - 1) + 3, 66, 1), force);
        }
    }
}

export fn tick_rooms() {
    audit_room1();
    audit_room2();
    audit_room3();
    audit_room4();
    audit_room5();
    audit_room6();
