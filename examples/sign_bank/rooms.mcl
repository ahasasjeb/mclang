fn marker_exists(slot) -> score {
    let found = 0;
    each(account_markers) {
        if scoreboard.get(self, account_slot) == slot { found = 1; }
    }
    return found;
}

export fn create_account_marker(slot) {
    if marker_exists(slot) == 0 {
        spawn("minecraft:marker", pos(0, 65, -5)) {
            self.add_tag("sb_account");
            scoreboard.set(self, account_slot, slot);
            scoreboard.set(self, account_balance, 0);
            scoreboard.set(self, account_size, 3);
        }
    }
}

