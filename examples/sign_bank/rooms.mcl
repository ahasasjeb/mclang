fn room_private(slot) -> score {
    let safe = 0;
    if slot == 1 && count(room1_players) == 1 { safe = 1; }
    if slot == 2 && count(room2_players) == 1 { safe = 1; }
    if slot == 3 && count(room3_players) == 1 { safe = 1; }
    if slot == 4 && count(room4_players) == 1 { safe = 1; }
    if slot == 5 && count(room5_players) == 1 { safe = 1; }
    if slot == 6 && count(room6_players) == 1 { safe = 1; }
    if slot == 7 && count(room7_players) == 1 { safe = 1; }
    if slot == 8 && count(room8_players) == 1 { safe = 1; }
    if slot == 9 && count(room9_players) == 1 { safe = 1; }
    if slot == 10 && count(room10_players) == 1 { safe = 1; }
    if slot == 11 && count(room11_players) == 1 { safe = 1; }
    if slot == 12 && count(room12_players) == 1 { safe = 1; }
    if slot == 13 && count(room13_players) == 1 { safe = 1; }
    if slot == 14 && count(room14_players) == 1 { safe = 1; }
    if slot == 15 && count(room15_players) == 1 { safe = 1; }
    if slot == 16 && count(room16_players) == 1 { safe = 1; }
    if slot == 17 && count(room17_players) == 1 { safe = 1; }
    if slot == 18 && count(room18_players) == 1 { safe = 1; }
    if slot == 19 && count(room19_players) == 1 { safe = 1; }
    if slot == 20 && count(room20_players) == 1 { safe = 1; }
    if slot == 21 && count(room21_players) == 1 { safe = 1; }
    if slot == 22 && count(room22_players) == 1 { safe = 1; }
    if slot == 23 && count(room23_players) == 1 { safe = 1; }
    if slot == 24 && count(room24_players) == 1 { safe = 1; }
    if slot == 25 && count(room25_players) == 1 { safe = 1; }
    if slot == 26 && count(room26_players) == 1 { safe = 1; }
    if slot == 27 && count(room27_players) == 1 { safe = 1; }
    if slot == 28 && count(room28_players) == 1 { safe = 1; }
    if slot == 29 && count(room29_players) == 1 { safe = 1; }
    if slot == 30 && count(room30_players) == 1 { safe = 1; }
    if slot == 31 && count(room31_players) == 1 { safe = 1; }
    if slot == 32 && count(room32_players) == 1 { safe = 1; }
    return safe;
}

@player fn valid_room_session() -> score {
    let valid = 0;
    let slot = scoreboard.get(self, session);
    if slot != 0 && scoreboard.get(self, in_room) == 1 && room_private(slot) == 1 { valid = 1; }
    return valid;
}

export @player fn deposit() {
    if valid_room_session() == 1 {
        title.actionbar(self, "正在存入绿宝石……");
        sound.self("minecraft:block.note_block.hat", master);
        do_deposit();
    } else { title.actionbar(self, "没有有效的独占仓库会话"); }
}

export @player fn withdraw() {
    if valid_room_session() == 1 {
        title.actionbar(self, "正在取出绿宝石……");
        sound.self("minecraft:block.note_block.hat", master);
        do_withdraw();
    } else { title.actionbar(self, "没有有效的独占仓库会话"); }
}

export @player fn upgrade() {
    if valid_room_session() == 1 {
        title.actionbar(self, "正在检查升级条件……");
        sound.self("minecraft:block.note_block.hat", master);
        do_upgrade();
    } else { title.actionbar(self, "没有有效的独占仓库会话"); }
}

export @player fn logout() {
    if scoreboard.get(self, session) != 0 {
        sound.self("minecraft:block.note_block.hat", master);
        force_logout();
    }
}

@player fn read_account_state() {
    let slot = scoreboard.get(self, session);
    let balance = 0;
    let size = 0;
    each(account_markers) {
        if scoreboard.get(self, account_slot) == slot {
            balance = scoreboard.get(self, account_balance);
            size = scoreboard.get(self, account_size);
        }
    }
    scoreboard.set(self, view_balance, balance);
    scoreboard.set(self, view_size, size);
}

@player fn show_status() {
    read_account_state();
    message.self(translate("chat.type.announcement", [text("银行余额"), score(self, view_balance)]) { color = "gold"; });
    message.self(translate("chat.type.announcement", [text("仓库边长"), score(self, view_size)]) { color = "aqua"; });
}

@player fn do_deposit() {
    scoreboard.set(self, transfer, 0);
    execute store.result(self, transfer) { clear(self, "minecraft:emerald"); }
    let amount = scoreboard.get(self, transfer);
    let slot = scoreboard.get(self, session);
    if amount > 0 {
        each(account_markers) {
            if scoreboard.get(self, account_slot) == slot {
                scoreboard.set(self, account_balance, scoreboard.get(self, account_balance) + amount);
            }
        }
        title.actionbar(self, "绿宝石已存入");
        sound.self("minecraft:entity.experience_orb.pickup", master);
    } else { title.actionbar(self, "背包里没有绿宝石"); }
    show_status();
}

@player fn do_withdraw() {
    read_account_state();
    let slot = scoreboard.get(self, session);
    if scoreboard.get(self, view_balance) > 0 {
        each(account_markers) {
            if scoreboard.get(self, account_slot) == slot {
                scoreboard.set(self, account_balance, scoreboard.get(self, account_balance) - 1);
            }
        }
        self.give_item(one_emerald);
        title.actionbar(self, "已取出 1 枚绿宝石");
    } else { title.actionbar(self, "账户余额为 0"); }
    show_status();
}

@player fn do_upgrade() {
    read_account_state();
    let slot = scoreboard.get(self, session);
    let size = scoreboard.get(self, view_size);
    let balance = scoreboard.get(self, view_balance);
    let next = size + 1;
    if size >= 10 { title.actionbar(self, "仓库已经达到 10×10"); }
    if size < 10 && balance < next { title.actionbar(self, "余额不足：费用等于新边长"); }
    if size < 10 && balance >= next {
        each(account_markers) {
            if scoreboard.get(self, account_slot) == slot {
                scoreboard.set(self, account_balance, balance - next);
                scoreboard.set(self, account_size, next);
            }
        }
        expand_room(slot, next);
        title.actionbar(self, "仓库升级完成");
        sound.self("minecraft:block.anvil.use", master);
        show_status();
    }
}

fn expand_room(slot, size) {
    if slot == 1 && size == 4 {
        fill(pos(104, 64, 3), pos(104, 69, 6), block_state("minecraft:air"));
        fill(pos(101, 64, 6), pos(103, 69, 6), block_state("minecraft:air"));
    }
    if slot == 1 && size == 5 {
        fill(pos(105, 64, 3), pos(105, 69, 7), block_state("minecraft:air"));
        fill(pos(101, 64, 7), pos(104, 69, 7), block_state("minecraft:air"));
    }
    if slot == 1 && size == 6 {
        fill(pos(106, 64, 3), pos(106, 69, 8), block_state("minecraft:air"));
        fill(pos(101, 64, 8), pos(105, 69, 8), block_state("minecraft:air"));
