}

fn audit_room1() {
    if count(room1_players) > 1 {
        each(room1_players) {
            title.actionbar(self, "仓库出现第二名玩家，强制退出");
            force_logout();
        }
    } else {
        each(room1_players) {
            if scoreboard.get(self, session) == 1 { scoreboard.set(self, in_room, 1); }
            else { force_logout(); }
        }
    }
}

