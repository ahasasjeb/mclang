fn install_room_buttons(slot) {
    if slot == 1 {
        clone(pos(5, 72, -7), pos(5, 72, -7), pos(101, 67, 1), force);
        clone(pos(6, 72, -7), pos(6, 72, -7), pos(103, 67, 1), force);
        clone(pos(7, 72, -7), pos(7, 72, -7), pos(101, 66, 1), force);
        clone(pos(8, 72, -7), pos(8, 72, -7), pos(103, 66, 1), force);
    }
    if slot == 2 {
        clone(pos(5, 72, -7), pos(5, 72, -7), pos(115, 67, 1), force);
        clone(pos(6, 72, -7), pos(6, 72, -7), pos(117, 67, 1), force);
