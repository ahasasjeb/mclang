fn marker_exists(slot) -> score {
    let found = 0;
    each(account_markers) {
        if scoreboard.get(self, account_slot) == slot { found = 1; }
    }
    return found;
}

export fn create_account_marker(slot) {
    if marker_exists(slot) == 0 {
        spawn("minecraft:marker", pos(0, 65, -5)) {
            self.add_tag("sb_account");
            scoreboard.set(self, account_slot, slot);
            scoreboard.set(self, account_balance, 0);
            scoreboard.set(self, account_size, 3);
        }
    }
}

export @player fn activate_new_account(slot) {
    unroll for index in 1..33 {
        if index == slot {
            fill(pos(100 + 14 * (index - 1) + 1, 64, 1), pos(100 + 14 * (index - 1) + 3, 69, 5), block_state("minecraft:air"));
            install_room_buttons(index);
        }
    }
    enter_account(slot);
}

fn install_room_buttons(slot) {
    unroll for index in 1..33 {
        if index == slot {
            clone(pos(5, 72, -7), pos(5, 72, -7), pos(100 + 14 * (index - 1) + 1, 67, 1), force);
            clone(pos(6, 72, -7), pos(6, 72, -7), pos(100 + 14 * (index - 1) + 3, 67, 1), force);
            clone(pos(7, 72, -7), pos(7, 72, -7), pos(100 + 14 * (index - 1) + 1, 66, 1), force);
            clone(pos(8, 72, -7), pos(8, 72, -7), pos(100 + 14 * (index - 1) + 3, 66, 1), force);
        }
    }
}

export @player fn enter_account(slot) {
    scoreboard.set(self, auth_mode, 0);
    scoreboard.set(self, pending_slot, 0);
    scoreboard.set(self, session, slot);
    scoreboard.set(self, in_room, 1);
    // 落点是小数坐标，而小数分量只接受字面量（编译期表达式是整数语义），这里保留显式展开。
    if slot == 1 { teleport(self, vec3(102.5, 64.0, 2.5), rotation(180, 0)); }
    if slot == 2 { teleport(self, vec3(116.5, 64.0, 2.5), rotation(180, 0)); }
